---
import type { CollectionEntry } from 'astro:content';
import { url, kindLabel } from '../lib';
interface Props { posts: CollectionEntry<'writing'>[]; showDesc?: boolean }
const { posts, showDesc = true } = Astro.props;
---
<ul class="list">
  {posts.map((p) => (
    <li>
      <a class="title" href={url(`writing/${p.id}`)}>{p.data.title}</a>
      <span class="meta">{kindLabel[p.data.kind]}{p.data.draft ? ' · draft' : ''}</span>
      {showDesc && <span class="desc">{p.data.description}</span>}
    </li>
  ))}
</ul>
