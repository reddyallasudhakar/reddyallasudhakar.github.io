---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, socials } from '../site';
import { url } from '../lib';

interface Props { title?: string; description?: string; wide?: boolean; type?: 'website' | 'article' }
const { title, description = site.description, wide = false, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: 'writing', label: 'Writing' },
  { href: 'about', label: 'About' },
];
const themes = [
  { value: 'light', icon: 'sun', label: 'Light theme' },
  { value: 'system', icon: 'monitor', label: 'Match system theme' },
  { value: 'dark', icon: 'moon', label: 'Dark theme' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url()}>{site.name}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={url(n.href)} aria-current={path.startsWith(`/${n.href}`) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="header-end">
          <div class="social-icons">
            {socials.map((s) => (
              <a href={s.url} aria-label={s.label} title={s.label} rel="me noopener" target={s.url.startsWith('http') ? '_blank' : undefined}>
                <Icon name={s.icon} />
              </a>
            ))}
          </div>
          <div class="theme-toggle" role="radiogroup" aria-label="Color theme">
            {themes.map((t) => (
              <button type="button" role="radio" data-theme-value={t.value} aria-label={t.label} title={t.label}>
                <Icon name={t.icon} />
              </button>
            ))}
          </div>
        </div>
      </div>
    </header>
    <main class:list={['page', { 'page--wide': wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} {site.name} · {site.location}</span>
        <a href={url('rss.xml')} class="rss"><Icon name="rss" /> RSS</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = document.querySelectorAll('[data-theme-value]');
        const current = () => root.dataset.theme || 'system';
        const sync = () => buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeValue === current())));
        buttons.forEach((b) => b.addEventListener('click', () => {
          const v = b.dataset.themeValue;
          if (v === 'system') delete root.dataset.theme; else root.dataset.theme = v;
          try { v === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', v); } catch {}
          sync();
        }));
        sync();
      })();
    </script>
  </body>
</html>
